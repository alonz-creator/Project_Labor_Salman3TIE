<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".home.HomeFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Toolbar -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleTextColor="@android:color/black" />

            <!-- Welcome User -->
            <TextView
                android:id="@+id/textWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/dark_slate"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Selamat datang, User!" />

            <!-- Menu Title -->
            <TextView
                android:id="@+id/textMenuTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/menu_title"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Menu Grid -->
            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:columnCount="2"
                app:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToSecond"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/color_p2"
                    android:text="@string/btn_to_second"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToThird"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/color_p3"
                    android:text="@string/btn_to_third"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFourth"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/color_p4"
                    android:text="@string/btn_to_fourth"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToFifth"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/color_p5"
                    android:text="@string/btn_to_fifth"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfile"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/color_p6"
                    android:text="@string/btn_to_sixth"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToTenth"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/material_dynamic_neutral30"
                    android:text="Pertemuan 10"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToEleventh"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:backgroundTint="@color/material_dynamic_neutral30"
                    android:text="Pertemuan 11"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:cornerRadius="30dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

            </androidx.gridlayout.widget.GridLayout>

            <!-- Cat Fact -->
            <TextView
                android:id="@+id/tvCatFact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Loading cat fact..."
                android:textAlignment="center"
                android:textSize="18sp" />

            <!-- Refresh Button -->
            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Refresh" />

            <!-- Photo Gallery -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGallery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Logout Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="#D9534F"
                android:text="@string/btn_logout"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
